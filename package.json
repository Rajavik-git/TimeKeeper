{
  "name": "timekeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "contract:gen": "openapi-typescript src/contracts/openapi.yaml -o src/contracts/generated.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsx watch src/backend/api/index.ts",
    "dev:ui": "vite --config src/frontend/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "build": "tsc -p tsconfig.backend.json && vite build --config src/frontend/vite.config.ts",
    "api:serve": "node dist/src/backend/api/index.js",
    "api:bundle": "node scripts/build-sidecar.mjs",
    "api:sidecar": "node scripts/build-sidecar.mjs --sidecar",
    "desktop:dev": "npm run api:sidecar && tauri dev",
    "desktop:build": "npm run api:sidecar && tauri build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^1.0.0",
    "@tauri-apps/api": "^2.0.0",
    "hono": "^4.0.0",
    "openapi-fetch": "^0.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "^8.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.0.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.0.0"
  }
}

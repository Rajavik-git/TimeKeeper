{
  "name": "timekeeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "node install.mjs",
    "setup:check": "node install.mjs --check",
    "contract:gen": "node --import tsx scripts/sync-state-contract.ts && openapi-typescript src/contracts/openapi.yaml -o src/contracts/generated.ts && node scripts/generate-request-contract.mjs",
    "db:reset": "node --env-file-if-exists=.env --import tsx scripts/reset-db.ts",
    "db:samples": "node --import tsx scripts/load-comparison-samples.ts",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "node --env-file-if-exists=.env --watch --import tsx src/backend/api/index.ts",
    "dev:ui": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config src/frontend/vite.config.ts",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "build": "tsc -p tsconfig.backend.json && vite build --config src/frontend/vite.config.ts",
    "api:serve": "node --env-file-if-exists=.env dist/src/backend/api/index.js",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@date-fns/tz": "1.4.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^1.0.0",
    "@tauri-apps/api": "^2.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "3.0.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.0.0",
    "openapi-fetch": "^0.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.59.2",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}

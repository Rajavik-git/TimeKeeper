# Optional JEV configuration for the TimeKeeper Screenpipe pipe.
# Copy this template beside the installed pipe.md as .env.
# Leave .env absent to skip JEV.

# Add the real key only to the installed .env file.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Select only fields approved for sending to TypeSafe.
# Case-switch comparisons need previous and new observations plus case descriptions.
# An empty key or field selection prevents requests.
JEV_ALLOWED_FIELDS=

# Example selection, to use only after approving these fields. It sends recorded screen text to TypeSafe.
# A synthetic test with window titles only returned false same_case results for an unknown folder and an ambiguous inbox.
# JEV_ALLOWED_FIELDS=previous_observation.text,previous_observation.window_title,observation.text,observation.window_title,candidates.reference,candidates.title

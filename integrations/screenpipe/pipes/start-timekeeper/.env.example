# Optional fallback for the Start TimeKeeper pipe when it cannot call the TimeKeeper MCP tool.
# Copy beside the installed pipe.md as .env and use absolute paths.
# The pipe runs `. ./.env && eval "$TIMEKEEPER_START_COMMAND"` in bash:
# wrap the whole value in single quotes and use forward slashes, also on Windows.
# Windows example (installed Node):
# TIMEKEEPER_START_COMMAND='"C:/Program Files/nodejs/node.exe" --import tsx "C:/path/to/TimeKeeper/src/mcp/start-session.ts"'
# macOS example:
# TIMEKEEPER_START_COMMAND='node --import tsx "/path/to/TimeKeeper/src/mcp/start-session.ts"'
TIMEKEEPER_START_COMMAND=

# The command calls http://127.0.0.1:8787/api. The pipe does not pass other .env values to it:
# set TIMEKEEPER_API_URL or TIMEKEEPER_LAUNCH_COMMAND as user environment variables if needed.

# Copy to .env in this folder and fill in locally. .env is ignored by Git.

# TypeSafe API key for JEV. Required unless you run with --dry-run.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# npm run jev:watch inherits the root key populated by npm run setup:auth.
# For a standalone watcher, set this locally or let screenpipe-mcp discover it.
# This key is separate from TYPESAFE_API_KEY.
SCREENPIPE_API_KEY=
# SCREENPIPE_API_URL=http://localhost:3030

# Fields that may be sent to TypeSafe. Empty prevents any run.
# Screen text gives reliable results but sends recorded text to TypeSafe.
# Window titles alone produced false "same case" results in synthetic tests (see docs/API.md D10).
JEV_ALLOWED_FIELDS=
# Example selection, to use only after approving these fields:
# JEV_ALLOWED_FIELDS=previous_observation.text,previous_observation.window_title,observation.text,observation.window_title,candidates.reference,candidates.title

# Optional settings
# JEV_MIN_CONFIDENCE=0.7
# WINDOW_MINUTES=5
# STABILITY_SECONDS=10
# MAX_TEXT_CHARS=600
# CASES_FILE=cases.json
# MCP_PACKAGE=screenpipe-mcp@0.20.3

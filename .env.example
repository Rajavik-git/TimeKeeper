# Shared frontend development server and backend configuration.
# Exported shell variables take precedence. Restart processes after changes.
# Keep these host and port defaults when running the Tauri desktop shell.

# Frontend development server
UI_HOST=127.0.0.1
UI_PORT=5173

# Backend API and frontend development proxy
TIMEKEEPER_PORT=8787

# SQLite path, relative to the repository root unless absolute
TIMEKEEPER_DB=data/timekeeper.db

# Additional allowed origins, comma-separated; leave empty for local defaults
TIMEKEEPER_ALLOWED_ORIGINS=

# Shared frontend development server and backend configuration.
# Exported shell variables take precedence. Restart processes after changes.
# Keep these host and port defaults when running the Tauri desktop shell.

# Frontend development server
UI_HOST=127.0.0.1
UI_PORT=5173

# Backend API and frontend development proxy
TIMEKEEPER_PORT=8787

# TimeKeeper MCP HTTP server and Screenpipe registration
TIMEKEEPER_MCP_PORT=3032

# Desktop API origin. Export this variable when invoking a production build.
# Browser development keeps the relative API proxy.
# Rebuild after changes and allow the same origin in src-tauri/tauri.conf.json CSP.
VITE_TIMEKEEPER_API_URL=http://127.0.0.1:8787

# SQLite path, relative to the repository root unless absolute
TIMEKEEPER_DB=data/timekeeper.db

# Additional allowed origins, comma-separated; leave empty for local defaults
TIMEKEEPER_ALLOWED_ORIGINS=

# Screenpipe URL for setup health checks and the JEV Screenpipe MCP reader.
# Keep this and SCREENPIPE_URL on the same instance unless intentionally separated.
# Use an HTTP loopback origin. The health request does not need an API token.
SCREENPIPE_API_URL=http://127.0.0.1:3030

# Backend source import, Settings > Screenpipe controls, and the recording link.
# Setup fills a missing SCREENPIPE_API_KEY through the installed Screenpipe CLI.
# Run npm run setup:auth to retry without reinstalling dependencies.
# Keep the token out of Git. Restart running processes after changes.
SCREENPIPE_URL=http://127.0.0.1:3030
SCREENPIPE_API_KEY=
SCREENPIPE_INSTANCE_ID=local

# Optional absolute path to Screenpipe's native CLI when it is not on PATH.
# SCREENPIPE_CLI=/absolute/path/to/screenpipe

# Shared frontend development server and backend configuration.
# Exported shell variables take precedence. Restart processes after changes.
# Keep these host and port defaults when running the Tauri desktop shell.

# Frontend development server
UI_HOST=127.0.0.1
UI_PORT=5173

# Backend API and frontend development proxy
TIMEKEEPER_PORT=8787

# Desktop API origin. Export this variable when invoking a production build.
# Browser development keeps the relative API proxy.
# Rebuild after changes and allow the same origin in src-tauri/tauri.conf.json CSP.
VITE_TIMEKEEPER_API_URL=http://127.0.0.1:8787

# SQLite path, relative to the repository root unless absolute
TIMEKEEPER_DB=data/timekeeper.db

# Additional allowed origins, comma-separated; leave empty for local defaults
TIMEKEEPER_ALLOWED_ORIGINS=

# Screenpipe API used by setup, focus/media reads, and the optional MCP session link.
# SCREENPIPE_URL takes precedence over SCREENPIPE_API_URL when nonempty.
# Use an HTTP loopback origin for setup. Public /health needs no token.
SCREENPIPE_API_URL=http://127.0.0.1:3030
# SCREENPIPE_URL=http://127.0.0.1:3030

# Protected Screenpipe reads. Setup fills a missing key via screenpipe auth token.
# Retry with npm run setup:auth. Keep the real token out of version control.
# A nonempty direct key takes precedence over the optional token file.
SCREENPIPE_API_KEY=
# SCREENPIPE_API_KEY_FILE=/absolute/path/to/screenpipe-token
# If the native CLI is outside PATH, set its absolute executable path.
# SCREENPIPE_CLI=/absolute/path/to/screenpipe

# TimeKeeper HTTP MCP, separate from the Screenpipe API token.
# Generate a random token before serving HTTP. Setup does not register MCP.
TIMEKEEPER_MCP_TOKEN=
# TIMEKEEPER_API_URL=http://127.0.0.1:8787
# TIMEKEEPER_LAUNCH_COMMAND=

# npm run mcp:serve enables the recording-session link on port 3032.
# It can start/end sessions from observed Screenpipe health.
# Omit --screenpipe-link in a direct MCP invocation for manual sessions only.
# TIMEKEEPER_LINK_GRACE_SECONDS=60
# TIMEKEEPER_MCP_STATE=data/screenpipe-link.json

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "noEmitOnError": true
  },
  "include": [
    "src/backend/**/*.ts",
    "src/contracts/**/*.ts",
    "src/mcp/**/*.ts",
    "integrations/screenpipe/jev-check/**/*.ts"
  ]
}
